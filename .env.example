# AirSense Pro - Environment Variables Template
# Copy this file to .env and fill in the values

# Google Gemini API Key
VITE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# API Keys - Primary Sources
VITE_API_KEY_IQAIR=YOUR_IQAIR_API_KEY_HERE
VITE_API_KEY_WAQI=YOUR_WAQI_API_KEY_HERE
VITE_API_KEY_WEATHER=YOUR_OPENWEATHERMAP_API_KEY_HERE
VITE_API_KEY_ACCUWEATHER=YOUR_ACCUWEATHER_API_KEY_HERE
VITE_API_KEY_WEATHERAPI=YOUR_WEATHERAPI_API_KEY_HERE

# IQAir API Keys for Indian Cities (distributed for faster loading)
VITE_API_KEY_IQAIR_CITY_1=YOUR_IQAIR_CITY_KEY_1_HERE
VITE_API_KEY_IQAIR_CITY_2=YOUR_IQAIR_CITY_KEY_2_HERE
VITE_API_KEY_IQAIR_CITY_3=YOUR_IQAIR_CITY_KEY_3_HERE
